{
  "name": "rentalapp-playwright-test-cases",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright automation test cases for RentalApp sprint 1 and sprint 2 flows.",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:smoke": "npx playwright test tests/smoke",
    "test:smoke:headed": "npx playwright test tests/smoke --headed",
    "test:regression": "npx playwright test tests",
    "test:regression:headed": "npx playwright test tests --headed",
    "test:debug": "npx playwright test --debug",
    "install:browsers": "npx playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.15.30",
    "mysql2": "^3.14.2",
    "typescript": "^5.8.3"
  }
}
